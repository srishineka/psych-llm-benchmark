# Copy this file to .env and fill in the keys you have.
# Never commit your real .env file.

# --- Patient agent (start here — free tiers) ---
GEMINI_API_KEY=your_gemini_key_here        # https://aistudio.google.com/apikey
MISTRAL_API_KEY=your_mistral_key_here      # https://console.mistral.ai/api-keys

# --- Therapist agent under test (free open-weight models via Groq) ---
GROQ_API_KEY=your_groq_key_here            # https://console.groq.com/keys

# --- Switch patient/evaluator to OpenAI later ---
OPENAI_API_KEY=your_openai_key_here        # https://platform.openai.com/api-keys

# --- Optional: Hugging Face token, needed only for gated model downloads ---
# (MentaLLaMA and EmoCareAI/ChatPsychiatrist are both open/ungated, so this
# is only required if you later add a gated model like meta-llama/Llama-2-7b-chat-hf)
HF_TOKEN=your_huggingface_token_here       # https://huggingface.co/settings/tokens
